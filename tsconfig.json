{
  // Root project: the repo-level tooling, not the packages.
  //
  // Each package carries its own tsconfig.json, which is also what lets ESLint's
  // `projectService` resolve every source file to a project without a solution
  // file listing them all. `npm run typecheck` runs this one and then each
  // package's in turn.
  "extends": "@kubermatic/config/tsconfig-react",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["*.ts", "*.d.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"]
}
