{
  "name": "kubermatic-ui-kit",
  "private": true,
  "description": "Workspace root for the Kubermatic frontend design system. Publishes nothing itself.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "prettier": "@kubermatic/config/prettier",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix .; status=$?; prettier --write .; exit $status",
    "check:deps": "npm run check:deps --workspaces --if-present"
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@chromatic-com/storybook": "5.3.0",
    "@eslint/js": "10.0.1",
    "@kubermatic/config": "*",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.10",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.21.0",
    "next-themes": "^0.4.6",
    "playwright": "1.62.1",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.80.0",
    "shadcn": "4.11.0",
    "sonner": "^2.0.7",
    "storybook": "^10.5.10",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.62.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.11"
  }
}
