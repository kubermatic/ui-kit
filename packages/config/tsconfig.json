{
  // Base tsconfig for every Kubermatic frontend package.
  //
  // Consume with:  { "extends": "@kubermatic/config/tsconfig" }
  //
  // This is the artifact that settles the ~5.9.3 vs ~6.0.3 split across the
  // products: the compiler version is pinned in versions.json and the flags it
  // runs with are pinned here, so "it typechecks on my machine" stops depending
  // on which of the two a repo happened to install.
  //
  // `noEmit` is the default because the common case is typecheck-only — the
  // library build emits declarations through vite-plugin-dts, not tsc. A package
  // that really does emit overrides it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // `isolatedModules` + `verbatimModuleSyntax` keep every file independently
    // transpilable, which is what lets Vite and esbuild compile without a type
    // checker in the loop.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "noEmit": true
  }
}
