{
  "name": "@kubermatic/ui-kit",
  "version": "0.2.0",
  "description": "Shared React component primitives and design tokens for Kubermatic dashboards",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/theme.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubermatic/ui-kit.git",
    "directory": "packages/ui-kit"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "check:deps": "kubermatic-config check"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.21.0",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "tailwindcss": "^4.3.0"
  }
}
