{
  "name": "@kubermatic/config",
  "version": "0.1.0",
  "description": "Toolchain configs and the dependency contract for the Kubermatic frontend stack",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kubermatic-config": "./bin/kubermatic-config.js"
  },
  "files": [
    "bin",
    "rules",
    "eslint.js",
    "eslint.d.ts",
    "prettier.js",
    "prettier.d.ts",
    "vitest.js",
    "vitest.d.ts",
    "tailwind.css",
    "tsconfig.json",
    "tsconfig-react.json",
    "renovate.json",
    "versions.json"
  ],
  "exports": {
    "./tailwind": "./tailwind.css",
    "./tsconfig": "./tsconfig.json",
    "./tsconfig-react": "./tsconfig-react.json",
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./rules": {
      "types": "./rules/index.d.ts",
      "default": "./rules/index.js"
    },
    "./prettier": {
      "types": "./prettier.d.ts",
      "default": "./prettier.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./renovate": "./renovate.json",
    "./versions.json": "./versions.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubermatic/ui-kit.git",
    "directory": "packages/config"
  },
  "scripts": {
    "check": "node ./bin/kubermatic-config.js check"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.10",
    "shadcn": "4.11.0",
    "tw-animate-css": "1.4.0",
    "typescript-eslint": "8.62.0"
  },
  "peerDependencies": {
    "@kubermatic/ui-kit": "*",
    "eslint": ">=10",
    "prettier": ">=3",
    "tailwindcss": "^4.3.0",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "@kubermatic/ui-kit": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
