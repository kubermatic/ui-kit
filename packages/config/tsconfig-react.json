{
  // React preset. Adds the JSX transform on top of the base.
  //
  // Consume with:  { "extends": "@kubermatic/config/tsconfig-react" }
  //
  // `react-jsx` rather than `react`: no `import React` needed per file, and it
  // is the transform React 19 expects.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
