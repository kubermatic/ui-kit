{
  "name": "@kubermatic/ui-kit",
  "version": "0.4.0",
  "description": "Kubermatic design system: tokens, theming and React primitives",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./theme.css": "./dist/theme.css",
    "./preflight.css": "./dist/preflight.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.42.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubermatic/ui-kit.git",
    "directory": "packages/ui-kit"
  },
  "homepage": "https://github.com/kubermatic/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/kubermatic/ui-kit/issues"
  },
  "keywords": [
    "kubermatic",
    "design-system",
    "react",
    "tailwind",
    "base-ui",
    "components"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
