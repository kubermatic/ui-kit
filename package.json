{
  "name": "@kubermatic/ui-kit",
  "version": "0.1.0",
  "description": "Shared React component primitives and design tokens for Kubermatic dashboards",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubermatic/ui-kit.git"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix .; status=$?; prettier --write .; exit $status"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "next-themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.6.0",
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.5.10",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.21.0",
    "next-themes": "^0.4.6",
    "playwright": "latest",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.80.0",
    "shadcn": "4.11.0",
    "sonner": "^2.0.7",
    "storybook": "^10.5.10",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.62.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.11"
  }
}
