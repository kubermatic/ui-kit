{
  "name": "kubermatic-ui-kit",
  "private": true,
  "description": "Workspace root for the Kubermatic design system. Publishes nothing itself.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix .; status=$?; prettier --write .; exit $status",
    "verify": "npm run lint && npm run typecheck && npm run test:all && npm run check:dist",
    "test:a11y": "vitest run --project a11y",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project unit --coverage",
    "changeset": "changeset",
    "version-packages": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token 2>/dev/null)} changeset version",
    "release": "changeset publish",
    "check:dist": "npm run build && npm run check:package",
    "check:package": "publint packages/ui-kit && publint packages/eslint-config && attw --pack packages/ui-kit --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@base-ui/react": "1.9.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/ubuntu": "5.3.0",
    "@kubermatic/eslint-config": "*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
